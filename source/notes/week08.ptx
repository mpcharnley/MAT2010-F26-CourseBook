  </coordinates>
</diagram>
            </prefigure>
            </image>
            <image width="60%">
                <shortdescription>Graph of secant of x.</shortdescription>
                <prefigure xmlns="https://prefigure.org"
             label="inv-fcn-sec-x">
            <diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
  <definition> f(x)=sec(x) </definition>
  <coordinates bbox="[-6,-6,6,6]">
    <grid-axes xlabel="x" ylabel="y"/>
