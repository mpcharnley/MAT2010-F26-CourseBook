    <page>
        <example workspace="4in">
            <statement>
                <p>
                    Find <m>\frac{dy}{dx}</m> for the implicit function
                    <md>
                        x^2e^y - y^2 = 4
                    </md>.
                    
                </p>
            </statement>
        
        </example>
        
    </page>

    <page>
        <example workspace="4in">
            <statement>
                <p>
                    Find <m>\frac{dy}{dx}</m> for the implicit function
                    <md>
                        \cos(x+y) = x^2y^3 - \sin(x)e^y
                    </md>.
                    
                </p>
            </statement>
        
        </example>
        
    </page>

    <page>
        <example workspace="0in">
            <introduction>
                <p>
                    Consider the equation 
                    <md>
                        x^2 + y^4 - 3xy = 16
                    </md>.
                    
                </p>
            </introduction>
            <task>
                <statement>
                    <p>
                        Find <m>\frac{dy}{dx}</m>.
                    </p>
                </statement>
        
            </task>
            <task>
                <statement>
                    <p>
                        Determine all points on the graph of this equation where the tangent line is horizontal (will not be able to find by hand).
                    </p>
                </statement>
            </task>
            <task>
                <statement>
                    <p>
                        Find <m>\frac{d^2y}{dx^2}</m>.
                    </p>
                </statement>
            </task>
        
