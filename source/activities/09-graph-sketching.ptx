<page>
<paragraphs>
    <title>Warm-Up</title>

<exercise>
    <statement>
        <p>
            Sketch the graph of the function <m>
                f(x) = \frac{x+4}{x-1}
            </m>.
            
        </p>
    </statement>
</exercise>
</paragraphs>

<paragraphs>
    <title>Turn-In Exercises</title>

<exercise>
    <statement>
        <p>
            Sketch the graph of the function <m>
                f(x) = \frac{3}{x^2 - 9}
            </m>.
            
        </p>
    </statement>
</exercise>

<exercise>
    <statement>
        <p>
            Sketch the graph of the function <m>
                f(x) = \frac{x}{x^2 - 4}
            </m>.
            
        </p>
    </statement>
</exercise>

<exercise>
    <introduction>
        <p>
            Let <m>f(x)</m> be the function whose formula and first two derivatives are given below:
            <md>
                f(x) = \frac{x+2}{(x-1)^2} \qquad f'(x) = -\frac{x+5}{(x-1)^3} \qquad f''(x) = \frac{2(x+8)}{(x-1)^4}
            </md>.
        </p>
    </introduction>
    <task>
        <statement>
            <p>
                Find all critical points of <m>f(x)</m> and determine if they are local maxima or local minima.
            </p>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                Find all intervals where <m>f(x)</m> is increasing.
            </p>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                Find all inflection points of <m>f(x)</m>.
            </p>
        </statement>
    </task>
    <task>
        <statement>
            <p>
                Find all intervals where <m>f(x)</m> is concave down.
            </p>
        </statement>
    </task>
</exercise>

<exercise>
    <statement>
        <p>
            Sketch a graph of a function <m>f(x)</m> that satifies all of the following properties.
            <ul>
                <li>
                    <p>
                        <m>f(0) = 2</m>
                    </p>
                </li>
                <li>
                    <p>
                        <m>\displaystyle \lim_{x\rightarrow \infty} f(x) = -2</m>
                    </p>
                </li>
                <li>
                    <p>
                        <m>\displaystyle \lim_{x\rightarrow -3^+} = -\infty</m> and <m>\displaystyle \lim_{x\rightarrow -3^-} = \infty</m>.
                    </p>
                </li>
                <li>
                    <p>
                        <m>\displaystyle \lim_{x\rightarrow -\infty} f(x) = 0</m>
                    </p>
                </li>
                <li>
                    <p>
                        Sign chart of <m>f'</m>
                    </p>
                    <image width="60%">
            <shortdescription>Sign Chart for f prime</shortdescription>
            <prefigure xmlns="https://prefigure.org"
             label="wksht-graph-sketching-sign-example-one">
<diagram xmlns="https://prefigure.org" dimensions="(500,100)" margins="5">
        <definition> numPts = 2 </definition>
         <definition> locs = [-5, 3] </definition>
         <definition substitution="no"> vals = ['-3', '3'] </definition>
         <definition> valMarks = ['UND', 'ZERO'] </definition>
         <definition> signs = ['+', '+', '-'] </definition>
         <definition> signs_loc = (-7, 0, 5) </definition>
          <coordinates bbox="[-10,-1,10,1]">
         <line endpoints="((-9,0), (9,0))" stroke="black" arrows="2" thickness="3"/>
        <repeat parameter="k=0..numPts-1">
            <line endpoints="((locs[k], -0.2), (locs[k], 0.2))" stroke="black" thickness="2"/>
            <label anchor="(locs[k], -0.2)" alignment="s"><m>${vals[k]}</m></label>
            <label anchor="(locs[k], 0.2)" alignment="n">${valMarks[k]}</label>
            <label anchor="(signs_loc[k], 0.3)" alignment="n"><m>${signs[k]}</m></label>
        </repeat>
        <label anchor="(signs_loc[numPts], 0.3)" alignment="n"><m>${signs[numPts]}</m></label>
  </coordinates>
</diagram>
  </prefigure>
        </image>
                </li>
                <li>
                    <p>
                        Sign chart of <m>f''</m>
                    </p>
                    <image width="60%">
            <shortdescription>Sign Chart for f double prime</shortdescription>
            <prefigure xmlns="https://prefigure.org"
             label="wksht-graph-sketching-sign-example-two">
<diagram xmlns="https://prefigure.org" dimensions="(500,100)" margins="5">
        <definition> numPts = 2 </definition>
         <definition> locs = [-5, 5] </definition>
         <definition substitution="no"> vals = ['-3', '6'] </definition>
         <definition> valMarks = ['UND', 'ZERO'] </definition>
         <definition> signs = ['+', '-', '+'] </definition>
         <definition> signs_loc = (-7, 0, 7) </definition>
          <coordinates bbox="[-10,-1,10,1]">
         <line endpoints="((-9,0), (9,0))" stroke="black" arrows="2" thickness="3"/>
        <repeat parameter="k=0..numPts-1">
            <line endpoints="((locs[k], -0.2), (locs[k], 0.2))" stroke="black" thickness="2"/>
            <label anchor="(locs[k], -0.2)" alignment="s"><m>${vals[k]}</m></label>
            <label anchor="(locs[k], 0.2)" alignment="n">${valMarks[k]}</label>
            <label anchor="(signs_loc[k], 0.3)" alignment="n"><m>${signs[k]}</m></label>
        </repeat>
        <label anchor="(signs_loc[numPts], 0.3)" alignment="n"><m>${signs[numPts]}</m></label>
  </coordinates>
</diagram>
  </prefigure>
        </image>
                </li>
            </ul>
        </p>
    </statement>
</exercise>

</paragraphs>
</page>

