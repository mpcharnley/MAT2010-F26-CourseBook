<diagram xmlns="https://prefigure.org" dimensions="(600,300)" margins="5">
  <definition> f(x)=sin(x)/x </definition>
  <coordinates bbox="[-10,-2,10,2]">
    <grid-axes xlabel="x" ylabel="y"/>
    <graph function="f" domain="[-10,0]"/>
    <graph function="f" domain="[0.001,10]"/>
    <point p="(0,1)" fill="white" stroke="blue" size="5"/>
  </coordinates>
</diagram>

