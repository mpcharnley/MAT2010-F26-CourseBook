<diagram xmlns="https://prefigure.org" dimensions="(600,300)" margins="5">
  <definition> f1(x) = sin(pi*x/2) </definition>
  <definition> f2(x) = 1 </definition>
  <definition> f3(x) = cos(pi*(x-3)/2) </definition>
  <definition> f4(x) = -1/2*(cos( pi*(x-5)/2)+1)</definition>
  <coordinates bbox="[0,-2,9,2]">
    <grid-axes xlabel="t" ylabel="s"/>
    <graph function="f1" domain="[0,1]"/>
    <graph function="f2" domain="[1,3]"/>
    <graph function="f3" domain="[3,5]"/>
    <graph function="f4" domain="[5,9]"/>
  </coordinates>
</diagram>

