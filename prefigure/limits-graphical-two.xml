<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
  <definition> g(x) = x+3 </definition>
  <definition> h(x)=-x/2</definition>
  <definition> f(x)=1-(x-3)^2 </definition>
  <definition> r(x)=(1/4)*(x^2 - 4) </definition>
  <coordinates bbox="[-3,-2,3,2]">
    <grid-axes xlabel="x" ylabel="y"/>
    <graph function="g" domain="[-3,-2]"/>
    <graph function="h" domain="[-2,0]"/>
    <graph function="r" domain="[0,2]"/>
    <graph function="f" domain="[2,3]"/>
    <point p="(0, h(0))" size="5" fill="white" stroke="blue"/>
    <point p="(0, r(0))" size="5" fill="white" stroke="blue"/>
    <point p="(2, f(2))" size="5" fill="white" stroke="blue"/>
  </coordinates>
</diagram>

