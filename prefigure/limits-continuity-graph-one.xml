<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
  <definition> g(x) = x+3 </definition>
  <definition> f(t) = (t^3 - 1, 2 - t^2)</definition>
  <definition> h(x) = 3-2*(x-1)^2</definition>
  <definition> r(x) = 2-1/(x-4)^2</definition>
  <coordinates bbox="[-6,-4,6,4]">
    <grid-axes xlabel="x" ylabel="y"/>
    <graph function="g" domain="[-5,-2]"/>
    <parametric-curve function="f" domain="(-1,1)" N="1000"/>
    <graph function="h" domain="[0,1]"/>
    <graph function="r" domain="[1, 3.95]"/>
    <graph function="r" domain="[4.05, 6]"/>
    <point p="(f(1))" size="5" fill="white" stroke="blue"/>
    <point p="(-2, g(-2))" size="5" fill="blue" stroke="blue"/>
    <point p="(1, h(1))" size="5" fill="white" stroke="blue"/>
    <point p="(1, r(1))" size="5" fill="blue" stroke="blue"/>
    <point p="(0, -2)" size="5" fill="blue" stroke="blue"/>
  </coordinates>
</diagram>

