<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
  <definition> g(x) = -1*(x+1)^2/((x-1)*(x+4))</definition>
  <definition> f(x)=3*(x+1)^2/((x-1)*(x+4)) </definition>
  <coordinates bbox="[-5,-10,5,10]">
    <grid-axes xlabel="x" ylabel="y"/>
    <graph function="g" domain="[-10,-4.1]"/>
    <graph function="f" domain="[-3.9,0.9]"/>
    <graph function="f" domain="[1.1,10]"/>
  </coordinates>
</diagram>

