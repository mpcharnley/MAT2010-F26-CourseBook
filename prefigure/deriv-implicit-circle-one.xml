<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
  <definition> a = 3 </definition>
  <definition> b =4 </definition>
  <definition> L(x) = -a/b*(x-a) + b </definition>
  <definition> f(x,y) = x^2 + y^2 </definition>
  <coordinates bbox="[-8,-8,8,8]">
    <grid-axes xlabel="x" ylabel="y"/>
    <implicit-curve function="f" k="25" stroke="blue" thickness = "3"/>
    <graph function="L" stroke="red" />
    <point p="(a,b)" size="3"> <m>(${a}, ${b})</m> </point>
  </coordinates>
</diagram>

