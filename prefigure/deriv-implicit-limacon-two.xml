<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
  <definition> a = 1.5 </definition>
  <definition> b =3 </definition>
  <definition> t1 = 1.823 </definition>
  <definition> t2 = 2*pi - t1 </definition>
  <definition> x(t) = (a + b*cos(t))*cos(t) </definition>
  <definition> y(t) = (a + b*cos(t))*sin(t) </definition>
  <definition> p(t) = (x(t), y(t)) </definition>
  <definition> f(x,y) = (x^2 + y^2 - b*x)^2 - a^2*(x^2 + y^2) </definition>
  <coordinates bbox="[-3,-6,6,6]">
    <grid-axes xlabel="x" ylabel="y"/>
    <parametric-curve function="p" domain="(0, t1)" stroke="blue" thickness = "3"/>
    <parametric-curve function="p" domain="(t1, pi)" stroke="red" thickness = "3"/>
 <parametric-curve function="p" domain="(pi, t2)" stroke="black" thickness = "3"/>
    <parametric-curve function="p" domain="(t2, 2*pi)" stroke="orange" thickness = "3"/>
  </coordinates>
</diagram>

