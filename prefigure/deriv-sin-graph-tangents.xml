<diagram xmlns="https://prefigure.org" dimensions="(300,100)" margins="5">
  <definition> f(x) = sin(x) </definition>
  <definition> a = pi/2 </definition>
  <coordinates bbox="[-7,-2,7,2]">
    <grid-axes xlabel="x" ylabel="y"/>
    <graph function="f" stroke="blue"/>
    <repeat parameter="k=-6..6">
    <definition> a = k*pi/2 </definition>
    <tangent-line function="f" point="a" domain="[a-0.5, a+0.5]"/>
    </repeat>
  </coordinates>
</diagram>

